# Copy to terraform.tfvars and adjust. Never put AWS keys here -
# use `aws configure`, AWS_PROFILE or SSO instead.
aws_region         = "ap-south-1"
project            = "hostelhub"
environment        = "dev"
vpc_cidr           = "10.40.0.0/16"
az_count           = 2
enable_nat_gateway = true

cluster_name        = "hostelhub-eks"
kubernetes_version  = "1.34"
node_instance_types = ["t3.medium"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 3

# Lock the API endpoint to your public IP, e.g. ["203.0.113.10/32"]
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]
